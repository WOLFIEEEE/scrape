# Copy to .env and fill in.

# --- API / web service -----------------------------------------------------
# dev or prod. Prod requires SCRAPE_JWT_SECRET.
SCRAPE_ENV=dev
SCRAPE_JWT_SECRET=
SCRAPE_COOKIE_SECURE=0
SCRAPE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SCRAPE_TRUST_PROXY_HEADERS=0
SCRAPE_SMTP_URL=

# --- Logging ---
LOG_LEVEL=INFO

# --- Proxy provider --------------------------------------------------------
# Supported: none, decodo, iproyal, brightdata, custom
PROXY_PROVIDER=none
# Endpoint without protocol, e.g. brd.superproxy.io:22225
PROXY_ENDPOINT=
PROXY_USERNAME=
PROXY_PASSWORD=
# ISO-2 country to pin (optional). Sticky sessions are encoded into the username.
PROXY_COUNTRY=
PROXY_STICKY_SESSION_MINUTES=10

# --- CAPTCHA solver --------------------------------------------------------
CAPSOLVER_API_KEY=
CAPSOLVER_TIMEOUT_S=120

# --- LLM extraction --------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_SMART=claude-sonnet-4-6

# --- Storage ---------------------------------------------------------------
# Defaults to ./data/scrape.db and ./data/raw
# STORAGE_SQLITE_PATH=
# STORAGE_RAW_HTML_DIR=

# --- Redis (optional, for distributed queue) -------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_KEY=scrape:queue

# --- Crawler tuning --------------------------------------------------------
CRAWL_MAX_CONCURRENCY=16
CRAWL_PER_HOST_CONCURRENCY=2
CRAWL_PER_HOST_MIN_DELAY_MS=500
CRAWL_REQUEST_TIMEOUT_S=30
CRAWL_MAX_RETRIES=3
CRAWL_RESPECT_ROBOTS=true
