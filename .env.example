# Copy to .env and fill in.

# --- API / web service -----------------------------------------------------
# dev or prod. Prod requires SCRAPE_JWT_SECRET.
SCRAPE_ENV=dev
SCRAPE_JWT_SECRET=
SCRAPE_COOKIE_SECURE=0
SCRAPE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SCRAPE_TRUST_PROXY_HEADERS=0
# Public origin used to build links in transactional emails (verify/reset).
# In prod this should be your real domain, e.g. https://app.scrape.dev
SCRAPE_PUBLIC_URL=http://localhost:3000
SCRAPE_METRICS_PORT=9090

# --- Email (transactional) -------------------------------------------------
# Provider: auto | resend | console | none
#   auto    → resend if RESEND_API_KEY set, else console (logs to stdout)
#   resend  → require RESEND_API_KEY, falls back to console with a warning
#   console → always log to stdout (good for local dev / self-host)
#   none    → silently drop emails (air-gapped deployments only)
EMAIL_PROVIDER=auto
EMAIL_FROM="Scrape <noreply@scrape.dev>"
EMAIL_SUPPORT=support@scrape.dev
EMAIL_BRAND=Scrape
# Resend (https://resend.com) — get a key, verify your domain, paste here.
RESEND_API_KEY=

# --- Logging ---
LOG_LEVEL=INFO

# --- Proxy provider --------------------------------------------------------
# Supported: none, decodo, iproyal, brightdata, custom
PROXY_PROVIDER=none
# Endpoint without protocol, e.g. brd.superproxy.io:22225
PROXY_ENDPOINT=
PROXY_USERNAME=
PROXY_PASSWORD=
# ISO-2 country to pin (optional). Sticky sessions are encoded into the username.
PROXY_COUNTRY=
PROXY_STICKY_SESSION_MINUTES=10

# --- CAPTCHA solver (Tier 2) -----------------------------------------------
# Paid: CapSolver. Optional — Tier 2 without a key is skipped.
CAPSOLVER_API_KEY=
CAPSOLVER_TIMEOUT_S=120

# --- Tier-3 unblock fallback ----------------------------------------------
# Three options, pick one:
#   flaresolverr → self-hosted, free, MIT-licensed Docker container.
#                  Beats plain Cloudflare JS challenges. Cannot beat
#                  PerimeterX / advanced Akamai / Kasada (behavioral scoring).
#   brightdata   → commercial Web Unlocker. Beats CF / Akamai / PerimeterX /
#                  Kasada. Pay ~$3 per 1,000 successful requests.
#   scrapfly     → commercial alternative. Credits-based billing, comparable
#                  ~$0.001-$0.025 per request depending on level.
UNBLOCK_PROVIDER=none
UNBLOCK_ENDPOINT=http://localhost:8191
UNBLOCK_TIMEOUT_S=60
# Bright Data Web Unlocker (only when UNBLOCK_PROVIDER=brightdata)
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=web_unlocker1
# Scrapfly (only when UNBLOCK_PROVIDER=scrapfly)
SCRAPFLY_API_KEY=

# --- LLM extraction --------------------------------------------------------
# Three backends: openrouter (default), anthropic (direct), ollama (self-hosted).
#   openrouter → OpenAI-compatible gateway over hundreds of models. Requires OPENROUTER_API_KEY.
#   anthropic  → Claude direct — requires ANTHROPIC_API_KEY (enables prompt caching)
#   ollama     → local Ollama server, free
#   auto       → OpenRouter if key set, else Anthropic, else Ollama
#   none       → LLM extraction disabled
LLM_BACKEND=openrouter

# OpenRouter (default; get a key at https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Pick any model from https://openrouter.ai/models — e.g.:
#   anthropic/claude-haiku-4.5 · anthropic/claude-sonnet-4.6
#   openai/gpt-4o-mini · google/gemini-2.5-flash · meta-llama/llama-3.1-70b-instruct
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution headers (shown on the OpenRouter dashboard)
OPENROUTER_REFERER=
OPENROUTER_APP_TITLE=Scrape

# Anthropic (only when LLM_BACKEND=anthropic, or auto with no OpenRouter key)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_SMART=claude-sonnet-4-6

# Ollama (only when LLM_BACKEND=ollama, or auto with no remote keys)
LLM_OLLAMA_URL=http://localhost:11434
LLM_OLLAMA_MODEL=qwen2.5:7b   # or llama3.1:8b · phi3.5:3.8b · numind/nuextract-2:7b

# --- Storage ---------------------------------------------------------------
# Defaults to ./data/scrape.db and ./data/raw
# STORAGE_SQLITE_PATH=
# STORAGE_RAW_HTML_DIR=

# --- Redis (optional, for distributed queue) -------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_KEY=scrape:queue

# --- Crawler tuning --------------------------------------------------------
CRAWL_MAX_CONCURRENCY=16
CRAWL_PER_HOST_CONCURRENCY=2
CRAWL_PER_HOST_MIN_DELAY_MS=500
CRAWL_REQUEST_TIMEOUT_S=30
CRAWL_MAX_RETRIES=3
CRAWL_RESPECT_ROBOTS=true
# Keep false for public/SaaS deployments. Set true only for trusted intranet use.
CRAWL_ALLOW_PRIVATE_NETWORKS=false
